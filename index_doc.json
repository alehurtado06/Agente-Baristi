{"text": "<meta name=\"dash-one-writer\">\n<style>\n  .bx { display: grid; gap: var(--cds-gap-xl); font-family: var(--font-anthropic-sans); color: var(--color-fg); }\n  .bx-head { display: grid; gap: var(--cds-gap-xs); }\n  .bx-title { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; text-wrap: balance; }\n  .bx-sub { color: var(--color-fg-muted); margin: 0; }\n  .bx-section { display: grid; gap: var(--cds-gap-md); }\n  .bx-h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; }\n  .bx-note { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); margin: 0; }\n  .bx-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: grid; gap: var(--cds-gap-sm); min-width: 0; align-content: start; }\n  .bx-card h3 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; }\n  .bx-grid { display: grid; gap: var(--cds-gap-md); grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); }\n  .bx-tiles { display: grid; gap: var(--cds-gap-md); grid-template-columns: repeat(auto-fit, minmax(min(100%, 10.5rem), 1fr)); }\n  .bx-tile { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-md) var(--cds-pad-lg); display: grid; gap: var(--cds-gap-xs); align-content: start; }\n  .bx-tile-label { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n  .bx-tile-value { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); font-variant-numeric: tabular-nums; line-height: 1.15; overflow-wrap: anywhere; }\n  .bx-tile-foot { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n  .bx-status { display: flex; flex-wrap: wrap; align-items: center; gap: var(--cds-gap-sm) var(--cds-gap-md); }\n  .bx-pill { display: inline-flex; align-items: center; gap: var(--cds-gap-xs); border: 1px solid var(--color-border-line); border-radius: 999px; padding: var(--cds-pad-xs) var(--cds-pad-md); font-weight: var(--cds-font-weight-medium); min-height: 1.75rem; min-width: 7rem; }\n  .bx-pill .dot { width: .55rem; height: .55rem; border-radius: 50%; background: var(--cds-chart-muted); }\n  .bx-pill.st-ok { color: var(--color-ok); } .bx-pill.st-ok .dot { background: var(--color-ok); }\n  .bx-pill.st-late { color: var(--color-bad); } .bx-pill.st-late .dot { background: var(--color-bad); }\n  .bx-pill.st-closed { color: var(--color-warn); } .bx-pill.st-closed .dot { background: var(--color-warn); }\n  .bx-table-wrap { overflow: auto; max-height: 26rem; }\n  .bx-table { width: 100%; border-collapse: collapse; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n  .bx-table th { text-align: left; font-weight: var(--cds-font-weight-medium); color: var(--color-fg-muted); padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); position: sticky; top: 0; background: var(--color-panel); white-space: nowrap; }\n  .bx-table td { padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); vertical-align: top; }\n  .bx-table .num { text-align: right; }\n  .bx-table td.wrap { min-width: 14rem; }\n  .bx-ok { color: var(--color-ok); } .bx-bad { color: var(--color-bad); }\n  .bx-legend { display: flex; flex-wrap: wrap; gap: var(--cds-gap-xs) var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .bx-legend span { display: inline-flex; align-items: center; gap: var(--cds-gap-xs); }\n  .bx-legend i { width: .7rem; height: .7rem; border-radius: 2px; display: inline-block; }\n  .bx-chart { position: relative; min-height: 15rem; }\n  .bx-chart svg { display: block; }\n  .bx-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); white-space: nowrap; }\n  .bx-tip .k { color: var(--cds-text-secondary); }\n  [data-dash-source-state=empty] { color: transparent; }\n  [data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n  .bx-fail { display: flex; align-items: center; justify-content: center; gap: var(--cds-gap-xs); color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); min-height: inherit; }\n  .bx-fail::before { content: \"\"; width: .375rem; height: .375rem; border-radius: 50%; background: var(--color-bad); }\n</style>\n\n<div class=\"bx\" lang=\"es\">\n  <header class=\"bx-head\">\n    <h1 class=\"bx-title\">Baristi en Uber Eats</h1>\n    <p class=\"bx-sub\">Si el agente de promociones está corriendo, qué propuso y cuánto deja cada tienda en Uber Eats.</p>\n  </header>\n\n  <section class=\"bx-section\" id=\"agente\">\n    <h2 class=\"bx-h2\">¿El agente está operando?</h2>\n    <div class=\"bx-card\" id=\"estado-agente\">\n      <div class=\"bx-status\">\n        <span class=\"bx-pill\"><i class=\"dot\"></i><span class=\"bx-lbl\" data-st=\"ok\" hidden>Operando</span><span class=\"bx-lbl\" data-st=\"late\" hidden>Atrasado</span><span class=\"bx-lbl\" data-st=\"closed\" hidden>Fuera de horario</span><span class=\"bx-lbl\" data-st=\"none\" hidden>Sin corridas</span></span>\n        <span data-draw=\"estado-frase\" data-source=\"estado\"></span>\n        <span class=\"bx-msg\" data-msg=\"ok\" hidden>La última corrida fue hace <b data-draw=\"hace\" data-source=\"estado\">—</b>, dentro del límite de <b data-draw=\"limite\">—</b> minutos.</span>\n        <span class=\"bx-msg\" data-msg=\"late\" hidden>Lleva <b data-draw=\"hace\" data-source=\"estado\">—</b> sin correr en horario de tiendas (el límite es <b data-draw=\"limite\">—</b> minutos). Revisa que la Mac esté prendida y que el agente esté programado.</span>\n        <span class=\"bx-msg\" data-msg=\"closed\" hidden>Fuera del horario de promociones (5:00 a 22:00, hora de Tijuana). La última corrida fue hace <b data-draw=\"hace\" data-source=\"estado\">—</b>.</span>\n        <span class=\"bx-msg\" data-msg=\"none\" hidden>Todavía no hay corridas registradas.</span>\n      </div>\n      <p class=\"bx-note\">Hora de Tijuana. El agente corre cada 10 minutos de 5:00 a 22:00; cada corrida revisa las 4 tiendas. Solo vuelve a consultar a Claude si cambió el clima, el inventario, la competencia o el bloque horario, o si pasó una hora.</p>\n    </div>\n\n    <div class=\"bx-tiles\">\n      <div class=\"bx-tile\" id=\"t-ultima\">\n        <span class=\"bx-tile-label\">Última corrida</span>\n        <span class=\"bx-tile-value\" data-draw=\"ultima\" data-source=\"estado\" data-field=\"ultima\">—</span>\n        <span class=\"bx-tile-foot\">Bloque: <span data-draw=\"bloque\" data-source=\"estado\" data-field=\"bloque\">—</span></span>\n      </div>\n      <div class=\"bx-tile\" id=\"t-motor\">\n        <span class=\"bx-tile-label\">Quién decidió</span>\n        <span class=\"bx-tile-value\" data-draw=\"motor\" data-source=\"estado\" data-field=\"motor\">—</span>\n        <span class=\"bx-tile-foot\">Claude, o reglas si Claude no respondió</span>\n      </div>\n      <div class=\"bx-tile\" id=\"t-aprobadas\">\n        <span class=\"bx-tile-label\">Promos aprobadas, última corrida</span>\n        <span class=\"bx-tile-value\" data-draw=\"aprobadas\" data-source=\"estado\" data-field=\"aprobadas\">—</span>\n        <span class=\"bx-tile-foot\">Pasaron el filtro financiero</span>\n      </div>\n      <div class=\"bx-tile\" id=\"t-bloqueadas\">\n        <span class=\"bx-tile-label\">Promos bloqueadas, última corrida</span>\n        <span class=\"bx-tile-value\" data-draw=\"bloqueadas\" data-source=\"estado\" data-field=\"bloqueadas\">—</span>\n        <span class=\"bx-tile-foot\">Perdían dinero o rompían una regla</span>\n      </div>\n      <div class=\"bx-tile\" id=\"t-whatsapp\">\n        <span class=\"bx-tile-label\">Alertas por WhatsApp</span>\n        <span class=\"bx-tile-value\" data-draw=\"whatsapp\" data-source=\"estado\" data-field=\"whatsapp\">—</span>\n        <span class=\"bx-tile-foot\">De la última corrida</span>\n      </div>\n    </div>\n\n    <div class=\"bx-card\" id=\"promos\">\n      <h3>Promociones propuestas</h3>\n      <p class=\"bx-note\">La más reciente primero. En modo \"proponer\" el agente no cambia nada en Uber Eats: solo sugiere.</p>\n      <div class=\"bx-table-wrap\">\n        <table class=\"bx-table\" data-source=\"promociones\" data-row-key=\"promo\">\n          <thead><tr>\n            <th data-field=\"corrida_at\">Cuándo</th>\n            <th data-field=\"tienda\">Tienda</th>\n            <th data-field=\"aprobada\">Filtro</th>\n            <th data-field=\"precio\" class=\"num\">Precio</th>\n            <th data-field=\"margen_pct\" class=\"num\">Margen</th>\n            <th data-field=\"mecanica\">Promoción</th>\n            <th data-field=\"motivo\">Motivo del bloqueo</th>\n          </tr></thead>\n          <tbody data-draw=\"promos-body\"></tbody>\n        </table>\n      </div>\n    </div>\n\n    <div class=\"bx-card\" id=\"corridas\">\n      <h3>Historial de corridas</h3>\n      <p class=\"bx-note\">Una fila por tienda en cada corrida.</p>\n      <div class=\"bx-table-wrap\">\n        <table class=\"bx-table\" data-source=\"corridas\" data-row-key=\"corrida\">\n          <thead><tr>\n            <th data-field=\"corrida_at\">Cuándo</th>\n            <th data-field=\"tienda\">Tienda</th>\n            <th data-field=\"bloque\">Bloque</th>\n            <th data-field=\"motor\">Decidió</th>\n            <th data-field=\"aprobadas\" class=\"num\">Aprobadas</th>\n            <th data-field=\"bloqueadas\" class=\"num\">Bloqueadas</th>\n          </tr></thead>\n          <tbody data-draw=\"corridas-body\"></tbody>\n        </table>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"bx-section\" id=\"competencia\">\n    <h2 class=\"bx-h2\">Competencia en Uber Eats</h2>\n    <p class=\"bx-note\">Revisión manual en Uber Eats el 3 de noviembre de 2026. Precios de lista; los descuentos aplican a artículos seleccionados. La primera fila son tus precios promedio y tus promos activas.</p>\n\n    <div class=\"bx-card\" id=\"tabla-competencia\">\n      <h3>Precios y promociones de la zona</h3>\n      <div class=\"bx-table-wrap\">\n        <table class=\"bx-table\" data-source=\"competencia\" data-row-key=\"competidor\">\n          <thead><tr>\n            <th data-field=\"competidor\">Cafetería</th>\n            <th data-field=\"zona\">Compite con</th>\n            <th data-field=\"posicion\">Precio</th>\n            <th data-field=\"latte\" class=\"num\">Latte</th>\n            <th data-field=\"frappe\" class=\"num\">Frappé</th>\n            <th data-field=\"promo\">Promoción activa</th>\n          </tr></thead>\n          <tbody data-draw=\"competencia-body\"></tbody>\n        </table>\n      </div>\n    </div>\n\n    <div class=\"bx-card\" id=\"respuesta-agente\">\n      <h3>Qué responde el agente a la competencia</h3>\n      <p class=\"bx-note\">Lo que escribió Claude en la última corrida de cada tienda.</p>\n      <div class=\"bx-table-wrap\">\n        <table class=\"bx-table\" data-source=\"analisis\" data-row-key=\"tienda\">\n          <thead><tr>\n            <th data-field=\"tienda\">Tienda</th>\n            <th data-field=\"corrida_at\">Cuándo</th>\n            <th data-field=\"respuesta_competencia\">Respuesta a la competencia</th>\n          </tr></thead>\n          <tbody data-draw=\"analisis-body\"></tbody>\n        </table>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"bx-section\" id=\"rentabilidad\">\n    <h2 class=\"bx-h2\">Rentabilidad en Uber Eats</h2>\n    <p class=\"bx-note\">Reporte de Uber Eats del 4 de octubre al 2 de noviembre de 2026, 4 tiendas. El costo de insumos es estimado por familia de producto.</p>\n\n    <div class=\"bx-tiles\">\n      <div class=\"bx-tile\" id=\"t-venta\">\n        <span class=\"bx-tile-label\">Venta</span>\n        <span class=\"bx-tile-value\" data-draw=\"tot-venta\" data-source=\"totales\" data-field=\"venta\">—</span>\n        <span class=\"bx-tile-foot\"><span data-draw=\"tot-pedidos\" data-source=\"totales\" data-field=\"pedidos\">—</span> pedidos</span>\n      </div>\n      <div class=\"bx-tile\" id=\"t-comision\">\n        <span class=\"bx-tile-label\">Comisión de Uber (con IVA)</span>\n        <span class=\"bx-tile-value\" data-draw=\"tot-comision\" data-source=\"totales\" data-field=\"comision_uber\">—</span>\n        <span class=\"bx-tile-foot\"><span data-draw=\"tot-comision-pct\" data-source=\"totales\" data-field=\"comision_pct\">—</span> de la venta</span>\n      </div>\n      <div class=\"bx-tile\" id=\"t-publicidad\">\n        <span class=\"bx-tile-label\">Publicidad en Uber</span>\n        <span class=\"bx-tile-value\" data-draw=\"tot-publicidad\" data-source=\"totales\" data-field=\"publicidad\">—</span>\n        <span class=\"bx-tile-foot\"><span data-draw=\"tot-publicidad-pct\" data-source=\"totales\" data-field=\"publicidad_pct\">—</span> de la venta</span>\n      </div>\n      <div class=\"bx-tile\" id=\"t-utilidad\">\n        <span class=\"bx-tile-label\">Te queda</span>\n        <span class=\"bx-tile-value\" data-draw=\"tot-utilidad\" data-source=\"totales\" data-field=\"utilidad\">—</span>\n        <span class=\"bx-tile-foot\">Margen <span data-draw=\"tot-margen\" data-source=\"totales\" data-field=\"margen_pct\">—</span>, después de Uber, publicidad e insumos</span>\n      </div>\n    </div>\n\n    <div class=\"bx-card\" id=\"peso-por-tienda\">\n      <h3>A dónde se va cada peso, por tienda</h3>\n      <p class=\"bx-note\">Cada barra es la venta de la tienda. Lo verde es lo que te queda.</p>\n      <div class=\"bx-legend\"><span><i data-seg=\"0\"></i>Insumos (estimado)</span><span><i data-seg=\"1\"></i>Comisión de Uber</span><span><i data-seg=\"2\"></i>Publicidad</span><span><i data-seg=\"3\"></i>Te queda</span></div>\n      <div class=\"bx-chart\" data-draw=\"chart-tiendas\" data-source=\"tiendas\"></div>\n    </div>\n\n    <div class=\"bx-grid\">\n      <div class=\"bx-card\" id=\"pedidos-hora\">\n        <h3>Pedidos por hora</h3>\n        <p class=\"bx-note\">Hora de Tijuana, suma de los 30 días.</p>\n        <div class=\"bx-chart\" data-draw=\"chart-horas\" data-source=\"horas\"></div>\n      </div>\n      <div class=\"bx-card\" id=\"familias\">\n        <h3>Venta y margen por familia</h3>\n        <p class=\"bx-note\">Margen antes de publicidad, con costo de insumos estimado.</p>\n        <div class=\"bx-table-wrap\">\n          <table class=\"bx-table\" data-source=\"familias\" data-row-key=\"familia\">\n            <thead><tr>\n              <th data-field=\"familia\">Familia</th>\n              <th data-field=\"unidades\" class=\"num\">Unidades</th>\n              <th data-field=\"venta\" class=\"num\">Venta</th>\n              <th data-field=\"margen_pct\" class=\"num\">Margen</th>\n            </tr></thead>\n            <tbody data-draw=\"familias-body\"></tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  </section>\n</div>\n\n<script>\n  const LIMITE_MIN = 30;             // más de esto sin correr en horario = atrasado\n  const APERTURA = 5, CIERRE = 22;   // horario de promociones, hora de Tijuana\n  const TZ = 'America/Tijuana';\n\n  const money = d3.format('$,.0f');\n  const money2 = d3.format('$,.2f');\n  const int = d3.format(',');\n  const pct = (v) => d3.format('.1f')(v) + '%';\n  const when = (iso) => new Date(iso).toLocaleString('es-MX', { timeZone: TZ, day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });\n  const tijuanaHour = () => Number(new Intl.DateTimeFormat('en-US', { timeZone: TZ, hour: 'numeric', hourCycle: 'h23' }).format(new Date()));\n  const ago = (iso) => {\n    const min = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 60000));\n    if (min < 60) return min + ' min';\n    const h = Math.floor(min / 60);\n    return h < 48 ? h + ' h ' + (min % 60) + ' min' : Math.round(h / 24) + ' días';\n  };\n\n  dash.calc('estado', {\n    inputs: ['corridas'],\n    title: 'Estado del agente',\n    description: 'La corrida más reciente: cuándo fue, quién decidió y cuántas promos aprobó o bloqueó entre todas las tiendas.',\n    fn: (corridas) => {\n      if (!corridas.length) return [];\n      const ultima = d3.max(corridas, (r) => r.corrida_at);\n      const ronda = corridas.filter((r) => r.hora_negocio === corridas.find((c) => c.corrida_at === ultima).hora_negocio);\n      const motores = [...new Set(ronda.map((r) => r.motor))];\n      return [{\n        ultima,\n        bloque: ronda[0].bloque,\n        motor: motores.join(', '),\n        tiendas: ronda.length,\n        aprobadas: d3.sum(ronda, (r) => Number(r.aprobadas)),\n        bloqueadas: d3.sum(ronda, (r) => Number(r.bloqueadas)),\n        whatsapp: ronda.some((r) => r.whatsapp_enviado === true || r.whatsapp_enviado === 'true') ? 'Enviadas' : 'No configuradas',\n      }];\n    },\n  });\n\n  dash.calc('totales', {\n    inputs: ['tiendas'],\n    title: 'Totales de las 4 tiendas',\n    description: 'Suma de las tiendas; comisión, publicidad y margen como porcentaje de la venta.',\n    fn: (tiendas) => {\n      const s = (k) => d3.sum(tiendas, (r) => Number(r[k]));\n      const venta = s('venta');\n      return [{\n        venta, pedidos: s('pedidos'), comision_uber: s('comision_uber'), publicidad: s('publicidad'), utilidad: s('utilidad'),\n        comision_pct: venta ? s('comision_uber') / venta * 100 : 0,\n        publicidad_pct: venta ? s('publicidad') / venta * 100 : 0,\n        margen_pct: venta ? s('utilidad') / venta * 100 : 0,\n      }];\n    },\n  });\n\n  const one = (id) => { const d = dash.data(id); return d.status === 'ok' && d.data.length ? d.data[0] : null; };\n  const stateOf = () => {\n    const e = one('estado');\n    if (dash.data('estado').status !== 'ok') return null;\n    if (!e) return 'none';\n    const h = tijuanaHour();\n    if (h < APERTURA || h >= CIERRE) return 'closed';\n    return (Date.now() - new Date(e.ultima).getTime()) / 60000 <= LIMITE_MIN ? 'ok' : 'late';\n  };\n  // Muestra solo la etiqueta y la frase que corresponden al estado.\n  dash.draw('estado-frase', () => {\n    const st = stateOf();\n    document.querySelectorAll('.bx-msg').forEach((m) => { m.hidden = m.dataset.msg !== st; });\n    document.querySelectorAll('.bx-lbl').forEach((m) => { m.hidden = m.dataset.st !== st; });\n    document.querySelectorAll('.bx-pill').forEach((p) => { p.className = 'bx-pill' + (st ? ' st-' + st : ''); });\n  });\n  dash.draw('limite', (el) => { el.textContent = String(LIMITE_MIN); });\n  dash.draw('hace', (el) => { const e = one('estado'); el.textContent = e ? ago(e.ultima) : '—'; });\n\n  const field = (id, key, fmt) => (el) => { const r = one(id); el.textContent = r ? fmt(r[key]) : '—'; };\n  dash.draw('ultima', field('estado', 'ultima', when));\n  dash.draw('bloque', field('estado', 'bloque', String));\n  dash.draw('motor', field('estado', 'motor', (v) => String(v).replace(/^claude/, 'Claude')));\n  dash.draw('aprobadas', field('estado', 'aprobadas', int));\n  dash.draw('bloqueadas', field('estado', 'bloqueadas', int));\n  dash.draw('whatsapp', field('estado', 'whatsapp', String));\n  dash.draw('tot-venta', field('totales', 'venta', money));\n  dash.draw('tot-pedidos', field('totales', 'pedidos', int));\n  dash.draw('tot-comision', field('totales', 'comision_uber', money));\n  dash.draw('tot-comision-pct', field('totales', 'comision_pct', pct));\n  dash.draw('tot-publicidad', field('totales', 'publicidad', money));\n  dash.draw('tot-publicidad-pct', field('totales', 'publicidad_pct', pct));\n  dash.draw('tot-utilidad', field('totales', 'utilidad', money));\n  dash.draw('tot-margen', field('totales', 'margen_pct', pct));\n\n  const cell = (tr, text, cls) => { const td = tr.insertCell(); td.textContent = text; if (cls) td.className = cls; return td; };\n  const rowsOf = (id) => { const d = dash.data(id); return d.status === 'ok' ? d.data : []; };\n\n  dash.draw('promos-body', (tb) => {\n    const rows = rowsOf('promociones').slice().sort((a, b) => d3.descending(a.corrida_at, b.corrida_at));\n    tb.replaceChildren();\n    rows.forEach((r) => {\n      const tr = tb.insertRow(); tr.dataset.key = r.promo;\n      cell(tr, when(r.corrida_at));\n      cell(tr, r.tienda);\n      const ok = r.aprobada === true || r.aprobada === 'true';\n      cell(tr, ok ? 'Aprobada' : 'Bloqueada', ok ? 'bx-ok' : 'bx-bad');\n      cell(tr, r.precio == null ? '' : money(Number(r.precio)), 'num');\n      cell(tr, r.margen_pct == null ? '' : pct(Number(r.margen_pct)), 'num');\n      cell(tr, r.mecanica, 'wrap');\n      cell(tr, r.motivo || '');\n    });\n  });\n\n  dash.draw('corridas-body', (tb) => {\n    const rows = rowsOf('corridas').slice().sort((a, b) => d3.descending(a.corrida_at, b.corrida_at));\n    tb.replaceChildren();\n    rows.forEach((r) => {\n      const tr = tb.insertRow(); tr.dataset.key = r.corrida;\n      cell(tr, when(r.corrida_at));\n      cell(tr, r.tienda);\n      cell(tr, r.bloque);\n      cell(tr, String(r.motor).replace(/^claude/, 'Claude'));\n      cell(tr, int(Number(r.aprobadas)), 'num');\n      cell(tr, int(Number(r.bloqueadas)), 'num');\n    });\n  });\n\n  dash.draw('competencia-body', (tb) => {\n    tb.replaceChildren();\n    rowsOf('competencia').forEach((r) => {\n      const tr = tb.insertRow();\n      const name = cell(tr, r.competidor);\n      if (r.posicion === 'tu cadena') { name.style.fontWeight = '600'; }\n      cell(tr, r.zona);\n      cell(tr, r.posicion);\n      cell(tr, r.latte == null ? '' : money(Number(r.latte)), 'num');\n      cell(tr, r.frappe == null ? '' : money(Number(r.frappe)), 'num');\n      cell(tr, r.promo, 'wrap');\n    });\n  });\n\n  dash.draw('analisis-body', (tb) => {\n    tb.replaceChildren();\n    rowsOf('analisis').forEach((r) => {\n      const tr = tb.insertRow();\n      cell(tr, r.tienda);\n      cell(tr, when(r.corrida_at));\n      const td = cell(tr, r.respuesta_competencia, 'wrap');\n      td.style.minWidth = '22rem';\n    });\n  });\n\n  dash.draw('familias-body', (tb) => {\n    tb.replaceChildren();\n    rowsOf('familias').forEach((r) => {\n      const tr = tb.insertRow();\n      cell(tr, r.familia);\n      cell(tr, int(Number(r.unidades)), 'num');\n      cell(tr, money(Number(r.venta)), 'num');\n      cell(tr, pct(Number(r.margen_pct)), 'num');\n    });\n  });\n\n  const failed = (el, id) => {\n    if (dash.data(id).status !== 'error') return false;\n    const p = document.createElement('div'); p.className = 'bx-fail'; p.textContent = 'Failed to load';\n    el.replaceChildren(p); return true;\n  };\n\n  // Segmentos de la barra por tienda: color 3 (verde) para lo que queda.\n  const SEGMENTS = [\n    { key: 'costo_insumos', name: 'Insumos (estimado)', color: () => dash.colors[1] },\n    { key: 'comision_uber', name: 'Comisión de Uber', color: () => dash.colors[0] },\n    { key: 'publicidad', name: 'Publicidad', color: () => dash.colors[3] },\n    { key: 'utilidad', name: 'Te queda', color: () => 'var(--color-ok)' },\n  ];\n\n  dash.onData(() => {\n    document.querySelectorAll('.bx-legend i[data-seg]').forEach((sw) => { sw.style.background = SEGMENTS[Number(sw.dataset.seg)].color(); });\n  });\n\n  dash.draw('chart-tiendas', (el) => {\n    el.replaceChildren();\n    if (failed(el, 'tiendas')) return;\n    const rows = rowsOf('tiendas');\n    if (!rows.length) return;\n    const W = Math.max(280, el.clientWidth), rowH = 54, barH = 22, H = rows.length * rowH;\n    const x = d3.scaleLinear([0, 1], [0, W]);\n    const svg = d3.select(el).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`).attr('height', H);\n    const tip = d3.select(el).append('div').attr('class', 'bx-tip').style('display', 'none');\n    rows.forEach((r, i) => {\n      const venta = Number(r.venta), y = i * rowH;\n      svg.append('text').attr('x', 0).attr('y', y + 14).attr('fill', 'var(--color-fg)').attr('font-size', 'var(--cds-font-size-caption)').text(r.tienda);\n      svg.append('text').attr('x', W).attr('y', y + 14).attr('text-anchor', 'end').attr('fill', 'var(--color-fg-muted)')\n        .attr('font-size', 'var(--cds-font-size-caption)').text(`${money(venta)} · margen ${pct(Number(r.margen_pct))}`);\n      let acc = 0;\n      SEGMENTS.forEach((s) => {\n        const v = Math.max(0, Number(r[s.key])), share = venta ? v / venta : 0;\n        svg.append('rect').attr('x', x(acc)).attr('y', y + 22).attr('width', Math.max(0, x(share) - 1)).attr('height', barH)\n          .attr('rx', 2).attr('fill', s.color())\n          .on('mousemove', (ev) => {\n            const [mx, my] = d3.pointer(ev, el);\n            tip.style('display', null).html('');\n            tip.append('div').attr('class', 'k').text(r.tienda);\n            tip.append('div').text(`${s.name}: ${money(v)} (${pct(share * 100)})`);\n            const tw = tip.node().offsetWidth;\n            tip.style('left', Math.min(Math.max(0, mx - tw / 2), el.clientWidth - tw) + 'px').style('top', (my - 48) + 'px');\n          })\n          .on('mouseleave', () => tip.style('display', 'none'));\n        acc += share;\n      });\n    });\n  });\n\n  dash.draw('chart-horas', (el) => {\n    el.replaceChildren();\n    if (failed(el, 'horas')) return;\n    const rows = rowsOf('horas').map((r) => ({ hora: Number(r.hora), pedidos: Number(r.pedidos), venta: Number(r.venta) }));\n    if (!rows.length) return;\n    const W = Math.max(260, el.clientWidth), H = 220, m = { t: 10, r: 4, b: 26, l: 0 };\n    const x = d3.scaleBand(rows.map((r) => r.hora), [m.l, W - m.r]).padding(0.25);\n    const y = d3.scaleLinear([0, d3.max(rows, (r) => r.pedidos)], [H - m.b, m.t]).nice();\n    const svg = d3.select(el).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`).attr('height', H);\n    const ticks = y.ticks(4);\n    const tickW = d3.max(ticks, (t) => String(t).length) * 7 + 6;\n    x.range([tickW, W - m.r]);\n    svg.append('g').selectAll('line').data(ticks).join('line')\n      .attr('x1', tickW).attr('x2', W - m.r).attr('y1', y).attr('y2', y).attr('stroke', 'var(--cds-chart-grid)');\n    svg.append('g').selectAll('text').data(ticks).join('text')\n      .attr('x', tickW - 6).attr('y', (t) => y(t) + 4).attr('text-anchor', 'end').attr('fill', 'var(--color-fg-muted)')\n      .attr('font-size', 'var(--cds-font-size-caption)').text((t) => int(t));\n    const peak = d3.max(rows, (r) => r.pedidos);\n    const tip = d3.select(el).append('div').attr('class', 'bx-tip').style('display', 'none');\n    svg.append('g').selectAll('rect').data(rows).join('rect')\n      .attr('x', (r) => x(r.hora)).attr('width', Math.min(32, x.bandwidth())).attr('y', (r) => y(r.pedidos))\n      .attr('height', (r) => y(0) - y(r.pedidos)).attr('rx', 2)\n      .attr('fill', (r) => r.pedidos === peak ? dash.colors[0] : 'var(--cds-chart-muted)')\n      .on('mousemove', (ev, r) => {\n        const [mx, my] = d3.pointer(ev, el);\n        tip.style('display', null).html('');\n        tip.append('div').attr('class', 'k').text(`${r.hora}:00 a ${r.hora + 1}:00`);\n        tip.append('div').text(`${int(r.pedidos)} pedidos · ${money(r.venta)}`);\n        const tw = tip.node().offsetWidth;\n        tip.style('left', Math.min(Math.max(0, mx - tw / 2), el.clientWidth - tw) + 'px').style('top', (my - 52) + 'px');\n      })\n      .on('mouseleave', () => tip.style('display', 'none'));\n    const every = x.bandwidth() < 22 ? 2 : 1;\n    svg.append('g').selectAll('text').data(rows.filter((r, i) => i % every === 0)).join('text')\n      .attr('x', (r) => x(r.hora) + Math.min(32, x.bandwidth()) / 2).attr('y', H - 8).attr('text-anchor', 'middle')\n      .attr('fill', 'var(--color-fg-muted)').attr('font-size', 'var(--cds-font-size-caption)').text((r) => r.hora + 'h');\n  });\n</script>\n", "edit": {"via": "claude", "at": "2026-11-04T15:34:38Z"}}